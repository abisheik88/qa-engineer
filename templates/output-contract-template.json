{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qa-pack:contract:{{skill-name}}:{{contract-name}}:1",
  "title": "{{Human-readable contract title}}",
  "description": "{{What a conforming report asserts. See docs/skills/output-contracts.md for the envelope standard, field semantics, and evolution rules.}}",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "skill", "generatedAt", "summary", "classification", "evidence"],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "{{skill-name}}/{{contract-name}}" },
        "version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "{{skill-name}}" },
        "version": { "type": "string" }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "summary": { "type": "string", "minLength": 1 },
    "classification": {
      "description": "{{Closed, action-oriented enum: every value must imply a different next action.}}",
      "enum": ["{{value-1}}", "{{value-2}}"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "description", "source"],
        "properties": {
          "type": { "enum": ["command", "file", "network", "console", "trace", "log", "diff"] },
          "description": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "excerpt": { "type": "string" }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "priority"],
        "properties": {
          "action": { "type": "string", "minLength": 1 },
          "priority": { "enum": ["high", "medium", "low"] },
          "command": { "type": "string" }
        }
      }
    },
    "metadata": { "type": "object" }
  }
}
