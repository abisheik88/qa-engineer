{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qa-pack:contract:qa-example:self-check-report:1",
  "title": "qa-example self-check report",
  "description": "Asserts the readability state of an installed QA Engineer Pack skill: whether the skill's own references and contract could be read end to end. Classification is action-oriented: pass requires nothing, degraded means specific files need reinstalling, fail means the installation is untrustworthy and should be redone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "skill", "generatedAt", "summary", "classification", "evidence"],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "qa-example/self-check-report" },
        "version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "qa-example" },
        "version": { "type": "string" }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "summary": { "type": "string", "minLength": 1 },
    "classification": {
      "description": "pass: every file read cleanly. degraded: SKILL.md and the contract read, but at least one reference did not. fail: the contract was unreadable or unparseable, or the report could not satisfy this schema.",
      "enum": ["pass", "degraded", "fail"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "description", "source"],
        "properties": {
          "type": { "enum": ["file"] },
          "description": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "excerpt": { "type": "string" }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "priority"],
        "properties": {
          "action": { "type": "string", "minLength": 1 },
          "priority": { "enum": ["high", "medium", "low"] },
          "command": { "type": "string" }
        }
      }
    },
    "metadata": { "type": "object" }
  }
}
