{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qa-pack:contract:qa-review:review-result:1",
  "title": "qa-review review result",
  "description": "A quality review of a test codebase: an overall verdict and score, per-dimension ratings, findings tied to the knowledge base, and recommendations. Proposes no code changes. classification is the overall quality verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "skill", "generatedAt", "summary", "classification", "evidence", "qualityScore", "dimensions"],
  "properties": {
    "contract": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": { "name": { "const": "qa-review/review-result" }, "version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" } }
    },
    "skill": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": { "name": { "const": "qa-review" }, "version": { "type": "string" } }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "summary": { "type": "string", "minLength": 1 },
    "classification": { "enum": ["strong", "adequate", "needs-work", "poor"] },
    "qualityScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["type", "description", "source"],
        "properties": {
          "type": { "enum": ["file", "diff", "report", "finding"] },
          "description": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "excerpt": { "type": "string" }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "rating", "note"],
        "properties": {
          "name": { "enum": ["architecture", "maintainability", "duplication", "naming", "page-objects", "fixtures", "assertions", "test-design"] },
          "rating": { "enum": ["strong", "adequate", "needs-work", "poor"] },
          "note": { "type": "string", "minLength": 1 },
          "domain": { "type": "string" }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["action", "priority"],
        "properties": {
          "action": { "type": "string", "minLength": 1 },
          "priority": { "enum": ["high", "medium", "low"] },
          "domain": { "type": "string" }
        }
      }
    },
    "metadata": { "type": "object" }
  }
}
