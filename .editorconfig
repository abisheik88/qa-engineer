# EditorConfig keeps formatting consistent across editors and contributors.
# https://editorconfig.org
# Enforced in CI by editorconfig-checker.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Trailing whitespace can be a deliberate hard line break in Markdown, and
# alignment inside code fences (diagrams, sample output) is intentional.
trim_trailing_whitespace = false
indent_size = unset

# Test fixtures are opaque recorded data (HAR, XML, diffs); their byte content is
# fixed by what a tool actually produced, so indentation is not enforced. Matched
# on the directory name alone: the exemption previously said `tests/fixtures` and
# stopped applying the moment the fixtures moved to `test/fixtures`, which failed
# CI on files whose whole purpose is to be byte-exact.
[**/fixtures/**]
indent_size = unset

# The recorded corpus is generated output compared byte-for-byte by a snapshot
# test; reformatting it would be a false diff.
[**/corpus/**]
indent_size = unset

[Makefile]
indent_style = tab
